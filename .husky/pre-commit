#!/bin/sh

# ── Vérification de typage ────────────────────────────────
echo "🔍 Type-checking (tsc --noEmit)..."
pnpm tsc --noEmit || {
  echo "❌ Erreurs de compilation TypeScript. Commit annulé."
  exit 1
}

echo "🔍 Type-checking packages/ + tests/ (tsconfig.test.json)..."
pnpm tsc:check:tests || {
  echo "❌ Erreurs de typage dans packages/ ou tests/. Commit annulé."
  exit 1
}

# ── Registre des invariants ───────────────────────────────
echo "🔍 Invariants registry (pnpm invariants:check)..."
pnpm invariants:check || {
  echo "❌ Registre des invariants incohérent ou vues générées périmées (lancer pnpm invariants). Commit annulé."
  exit 1
}

# ── Gate de non-régression ────────────────────────────────
echo "🧪 Running regression tests..."
pnpm test:regression || {
  echo "❌ Tests de non-régression en échec. Commit annulé."
  exit 1
}

# ── Informatif : statut Tested des ADRs (ADR-32) ────────
# Non-bloquant — purement indicatif.
npx tsx lib/check-adr-tested-status.ts || true

echo "✅ Pre-commit checks passed."
